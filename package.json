{
  "name": "dsh-image-viewer",
  "version": "0.1.0",
  "description": "Image viewing for the dsh Web GUI: an expandable card for the model's read_image calls, a browsable index of every workspace image, and a same-origin route a reply can embed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "image",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MewKon/dsh-image-viewer.git"
  },
  "license": "MIT"
}
