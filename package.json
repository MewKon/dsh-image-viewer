{
  "name": "dsh-image-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 界面的图片查看器：模型读取图片时可点击放大，并在界面上浏览工作区里的图片",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/host.test.mjs"
  },
  "license": "MIT"
}
